{
  "name": "drap",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "random:bytes": "node ./src/scripts/generate-random-bytes.js",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "pnpm run --workspace-root --parallel /^lint:/",
    "lint:svelte": "svelte-check --fail-on-warnings",
    "lint:eslint": "eslint --cache --concurrency auto",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker compose --file compose.yaml --file compose.dev.yaml up --wait",
    "docker:dev:ci": "docker compose --file compose.yaml --file compose.dev.yaml --file compose.dev.ci.yaml up --wait",
    "docker:prod": "docker compose --file compose.yaml --file compose.prod.yaml up --wait",
    "docker:prod:app": "docker compose --file compose.yaml --file compose.prod.yaml --file compose.prod.app.yaml up --wait",
    "docker:prod:app:tls": "docker compose --file compose.yaml --file compose.prod.yaml --file compose.prod.app.yaml --file compose.prod.app.tls.yaml up --wait",
    "docker:dev:setup:bucket": "docker compose --file compose.yaml --file compose.dev.yaml --profile setup run --rm --no-deps setup-bucket",
    "docker:prod:setup:bucket": "docker compose --file compose.yaml --file compose.prod.yaml --profile setup run --rm --no-deps setup-bucket",
    "docker:prod:setup:database": "docker compose --file compose.yaml --file compose.prod.yaml --file compose.prod.app.yaml --profile setup run --rm --no-deps setup-database",
    "docker:down": "docker compose down --remove-orphans",
    "install:playwright": "playwright install --only-shell chromium",
    "test:unit": "vitest",
    "test:playwright": "playwright test",
    "ui": "shadcn-svelte add --yes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@better-svelte-email/components": "^2.3.0",
    "@better-svelte-email/server": "^2.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.77.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@selemondev/svgl-svelte": "^2.17.0",
    "@sveltejs/kit": "^2.70.3",
    "@tanstack/svelte-query": "^6.2.1",
    "@tanstack/svelte-table": "^9.2.4",
    "bits-ui": "^2.19.2",
    "cn": "^0.3.0",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "decode-formdata": "^0.9.0",
    "devalue": "^5.9.2",
    "drizzle-orm": "^0.45.2",
    "email-addresses": "^5.0.0",
    "get-stream": "^9.0.1",
    "http-parser-js": "^0.5.10",
    "http-raw-request": "^2.0.2",
    "inngest": "^4.20.0",
    "itertools": "^2.7.1",
    "jose": "^6.2.12",
    "layerchart": "^2.5.0",
    "mime-types": "^3.0.2",
    "mimetext": "^3.0.28",
    "mode-watcher": "^1.1.0",
    "multipart-ts": "^1.4.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "runed": "^0.37.1",
    "svelte": "^5.57.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tldts": "^7.4.13",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/eslint-plugin-svelte": "^0.66.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "oxfmt": "^0.68.0",
    "playwright": "^1.63.0",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
